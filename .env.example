# ==========================================
# HUST Cine - Local Environment Variables
# Default settings work out-of-the-box
# ==========================================

NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:4000

# Zero-Docker SQLite Database
DATABASE_URL="file:./dev.db"

# JWT & Authentication
JWT_SECRET=hustcine-dev-secret-access-token-key-2026
JWT_REFRESH_SECRET=hustcine-dev-secret-refresh-token-key-2026
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment & QR Ticket Security
PAYMENT_WEBHOOK_SECRET=hustcine-local-mock-webhook-secret-key-2026
QR_HMAC_SECRET=hustcine-qr-ticket-hmac-signing-secret-2026

# Next.js Public Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
